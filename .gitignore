# Local-only: disabled skills for lean configuration
# These skills are kept in the repository but disabled locally
.disabled/

# Local / secrets
.env
.env.*
!.env.example
*.local

# OS
.DS_Store
Thumbs.db

# Git worktrees (agent isolated work branches)
.worktrees/

# Large skills backup directory (use .agent/skills/ instead)
all_skills_stored/

# Local Claude permissions (machine-specific)
.claude/settings.local.json

# IDE / tool caches (keep config, ignore caches)
.claude/memory/*.local.md
.planning/state.local.json

# Browser automation artifacts (agent research runs)
.playwright-mcp/

# Archive tools — local install only, never in apps/web
tools/node_modules/

# Photo ingest — generated derivatives, manifest, and the founder's working
# authorship sheet. Local working files, never committed; open authorship.tsv
# directly from tools/ingest/output/ to fill it in.
tools/ingest/output/

# Export output — written by tools/export/index.ts during local runs and CI;
# never committed — the point is that it lives in Eva's R2, not this repo
apps/web/eva-and-adam-archive/

# Regenerable from the source PNGs via docs/08-agents_work/tools/key_assets.py
docs/08-agents_work/screens/*/keyed/

# Python bytecode (committed once by mistake from docs tooling)
__pycache__/
*.pyc

# Node — the repo root is not an install target; apps manage their own
node_modules/
